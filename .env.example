# Copy to .env for local development. Do not use these development values in production.
POSTGRES_DB=pantaetl
POSTGRES_USER=pantaetl
POSTGRES_PASSWORD=pantaetl-dev
DATABASE_URL=postgresql://pantaetl:pantaetl-dev@127.0.0.1:5432/pantaetl

BETTER_AUTH_SECRET=replace-this-with-a-unique-local-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
SCHEDULER_INTERNAL_TOKEN=replace-this-with-a-unique-local-token-of-at-least-32-characters

# Optional direct-service overrides.
# HOST=127.0.0.1
# GC_INTERVAL_SECONDS=60
# SCHEDULER_RUN_URL=http://127.0.0.1:3010/internal/pipeline-runs
# GC_BATCH_SIZE=100
# STORAGE_ROOT=/var/lib/pantaetl/storage
# WORKER_ID=00000000-0000-0000-0000-000000000000
# LOG_LEVEL=info
