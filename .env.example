# Copy to .env for local development. Do not use these development values in production.
POSTGRES_DB=pantaetl
POSTGRES_USER=pantaetl
POSTGRES_PASSWORD=pantaetl-dev
DATABASE_URL=postgresql://pantaetl:pantaetl-dev@127.0.0.1:5432/pantaetl

BETTER_AUTH_SECRET=replace-this-with-a-unique-local-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
