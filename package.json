{
  "name": "pantaetl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm web:check",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "web:build": "pnpm --filter web build",
    "web:check": "pnpm --filter web check",
    "web:dev": "pnpm --filter web dev",
    "web:generate-routes": "pnpm --filter web generate-routes",
    "web:typecheck": "pnpm --filter web typecheck"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
