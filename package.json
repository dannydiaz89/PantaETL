{
  "name": "pantaetl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/development.mjs setup",
    "generate": "node scripts/development.mjs generate",
    "generate:check": "node scripts/development.mjs generate-check",
    "dev": "pnpm web:dev",
    "check": "pnpm lint && pnpm typecheck && pnpm packages:check && pnpm test && pnpm web:check && pnpm web:a11y && pnpm services:check",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "web:build": "pnpm --filter web build",
    "web:check": "pnpm --filter web check",
    "web:a11y": "pnpm --filter web test:a11y",
    "web:dev": "pnpm --filter web dev",
    "web:generate-routes": "pnpm --filter web generate-routes",
    "web:typecheck": "pnpm --filter web typecheck",
    "services:check": "pnpm scheduler:check && pnpm garbage-collector:check",
    "scheduler:build": "pnpm --filter scheduler build",
    "scheduler:check": "pnpm --filter scheduler check",
    "scheduler:dev": "pnpm --filter scheduler dev",
    "scheduler:start": "pnpm --filter scheduler start",
    "garbage-collector:build": "pnpm --filter garbage-collector build",
    "garbage-collector:check": "pnpm --filter garbage-collector check",
    "garbage-collector:dev": "pnpm --filter garbage-collector dev",
    "garbage-collector:start": "pnpm --filter garbage-collector start",
    "worker:check": "uv run ruff check workers tests && uv run ruff format --check workers tests && uv run mypy workers && uv run pytest",
    "worker:dev": "uv run --env-file .env python -m workers.python",
    "packages:build": "pnpm --filter @pantaetl/contracts build && pnpm --filter @pantaetl/config build && pnpm --filter @pantaetl/logging build && pnpm --filter @pantaetl/pipeline build && pnpm --filter @pantaetl/database build && pnpm --filter @pantaetl/ui build",
    "packages:check": "pnpm --filter @pantaetl/contracts check && pnpm --filter @pantaetl/pipeline check && pnpm --filter @pantaetl/database check && pnpm --filter @pantaetl/ui check && pnpm --filter @pantaetl/config check && pnpm --filter @pantaetl/logging check",
    "db:migration:generate": "pnpm --filter @pantaetl/database migrate:generate",
    "db:migrate": "node scripts/development.mjs migrate",
    "stack:up": "node scripts/development.mjs stack-up",
    "stack:status": "node scripts/development.mjs stack-status",
    "stack:reset": "node scripts/development.mjs stack-reset"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "typescript": "6.0.3",
    "tailwindcss": "^4.1.13",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
