{
  "name": "@pantaetl/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run tests",
    "migrate:generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate:apply": "drizzle-kit migrate --config drizzle.config.ts",
    "migrate:studio": "drizzle-kit studio --config drizzle.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.10"
  }
}
