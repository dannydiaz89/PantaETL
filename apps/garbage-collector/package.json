{
  "name": "garbage-collector",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pantaetl/database build && tsx src/main.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run tests",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@pantaetl/database": "workspace:*"
  }
}
