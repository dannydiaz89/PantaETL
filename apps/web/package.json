{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "generate-routes": "tsr generate",
    "typecheck": "pnpm generate-routes && tsc --noEmit",
    "build": "pnpm generate-routes && vite build && tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "check": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@pantaetl/contracts": "workspace:*",
    "@pantaetl/database": "workspace:*",
    "@pantaetl/pipeline": "workspace:*",
    "@pantaetl/ui": "workspace:*",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.6.27",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
