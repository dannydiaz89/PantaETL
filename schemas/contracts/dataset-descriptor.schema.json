{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical contract definition. Generated language artifacts must not be edited manually.",
  "title": "DatasetDescriptor",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "v1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "family": {
      "type": "string",
      "enum": [
        "any",
        "document",
        "tabular",
        "file"
      ]
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "storage": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "local",
            "s3"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "encrypted": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "location",
        "encrypted"
      ],
      "additionalProperties": false
    },
    "structure": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "nullable": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "format"
      ],
      "additionalProperties": false
    },
    "pipelineId": {
      "type": "string",
      "format": "uuid"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "stepId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contractVersion",
    "id",
    "family",
    "format",
    "storage",
    "pipelineId",
    "runId",
    "stepId",
    "createdAt",
    "expiresAt"
  ],
  "additionalProperties": false,
  "$id": "https://pantaetl.dev/schemas/dataset-descriptor.schema.json"
}
