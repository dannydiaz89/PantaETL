{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical contract definition. Generated language artifacts must not be edited manually.",
  "title": "SourceExecutionRequest",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "v1"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "pipelineId": {
      "type": "string",
      "format": "uuid"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "stepId": {
      "type": "string",
      "format": "uuid"
    },
    "componentId": {
      "type": "string",
      "format": "uuid"
    },
    "componentType": {
      "type": "string",
      "pattern": "^source\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "componentVersion": {
      "type": "string",
      "pattern": "^v\\d+$"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "values": {
          "type": "object",
          "patternProperties": {
            "^(?!(?:.*(?:[Aa][Pp][Ii][_\\-]?[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]))).+$": {
              "$ref": "#/$defs/nonSecretJsonValue"
            }
          },
          "additionalProperties": false
        },
        "secretBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "binding": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "key",
              "binding"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "values",
        "secretBindings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "jobId",
    "pipelineId",
    "runId",
    "stepId",
    "componentId",
    "componentType",
    "componentVersion",
    "configuration"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonSecretJsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonSecretJsonValue"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(?!(?:.*(?:[Aa][Pp][Ii][_\\-]?[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]))).+$": {
              "$ref": "#/$defs/nonSecretJsonValue"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$id": "https://pantaetl.dev/schemas/source-execution-request.schema.json"
}
