{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical contract definition. Generated language artifacts must not be edited manually.",
  "title": "Job",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "v1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "pipelineId": {
      "type": "string",
      "format": "uuid"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "stepId": {
      "type": "string",
      "format": "uuid"
    },
    "componentId": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retryPolicy": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "retryDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxAttempts",
        "retryDelaySeconds"
      ],
      "additionalProperties": false
    },
    "availableAt": {
      "type": "string",
      "format": "date-time"
    },
    "claim": {
      "type": "object",
      "properties": {
        "workerId": {
          "type": "string",
          "format": "uuid"
        },
        "claimedAt": {
          "type": "string",
          "format": "date-time"
        },
        "heartbeatAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workerId",
        "claimedAt",
        "heartbeatAt"
      ],
      "additionalProperties": false
    },
    "cancellation": {
      "type": "object",
      "properties": {
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "requestedByUserId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "requestedAt"
      ],
      "additionalProperties": false
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contractVersion",
    "id",
    "pipelineId",
    "runId",
    "stepId",
    "componentId",
    "state",
    "attempt",
    "retryPolicy",
    "availableAt"
  ],
  "additionalProperties": false,
  "$id": "https://pantaetl.dev/schemas/job.schema.json"
}
