{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical contract definition. Generated language artifacts must not be edited manually.",
  "title": "ArtifactDescriptor",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "v1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "pipelineId": {
      "type": "string",
      "format": "uuid"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "contentType": {
      "type": "string",
      "minLength": 1
    },
    "fileName": {
      "type": "string",
      "minLength": 1
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "storage": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "local",
            "s3"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "encrypted": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "location",
        "encrypted"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "retention": {
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "retentionDays": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 30,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "expiresAt",
        "retentionDays"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "id",
    "pipelineId",
    "runId",
    "format",
    "fileName",
    "sizeBytes",
    "storage",
    "createdAt",
    "retention"
  ],
  "additionalProperties": false,
  "$id": "https://pantaetl.dev/schemas/artifact-descriptor.schema.json"
}
