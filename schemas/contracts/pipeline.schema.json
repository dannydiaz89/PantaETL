{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical contract definition. Generated language artifacts must not be edited manually.",
  "title": "Pipeline",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "v1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "ownerUserId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "enabled",
        "disabled"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "transform",
              "export"
            ]
          },
          "componentType": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "componentVersion": {
            "type": "string",
            "pattern": "^v\\d+$"
          },
          "configuration": {
            "type": "object",
            "properties": {
              "values": {
                "type": "object",
                "patternProperties": {
                  "^(?!(?:.*(?:[Aa][Pp][Ii][_\\-]?[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]))).+$": {
                    "$ref": "#/$defs/nonSecretJsonValue"
                  }
                },
                "additionalProperties": false
              },
              "secretBindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "binding": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "key",
                    "binding"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "values",
              "secretBindings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "componentType",
          "componentVersion",
          "configuration"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromStepId": {
            "type": "string",
            "format": "uuid"
          },
          "toStepId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "fromStepId",
          "toStepId"
        ],
        "additionalProperties": false
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "pipelineId": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "type": "string",
                "const": "manual"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "pipelineId",
              "type",
              "enabled"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "pipelineId": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "type": "string",
                "const": "schedule"
              },
              "enabled": {
                "type": "boolean"
              },
              "cron": {
                "type": "string",
                "minLength": 1
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "pipelineId",
              "type",
              "enabled",
              "cron",
              "timezone"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "contractVersion",
    "id",
    "ownerUserId",
    "name",
    "state",
    "createdAt",
    "updatedAt",
    "steps",
    "edges",
    "triggers"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonSecretJsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonSecretJsonValue"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^(?!(?:.*(?:[Aa][Pp][Ii][_\\-]?[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]))).+$": {
              "$ref": "#/$defs/nonSecretJsonValue"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$id": "https://pantaetl.dev/schemas/pipeline.schema.json"
}
