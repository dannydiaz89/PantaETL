{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical contract definition. Generated language artifacts must not be edited manually.",
  "title": "Run",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "v1"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "pipelineId": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "completed_with_warnings",
        "failed",
        "cancelled"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cancellationRequestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "warningCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stepId": {
            "type": "string",
            "format": "uuid"
          },
          "componentId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "completed_with_warnings",
              "failed",
              "cancelled"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "warningCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "metrics": {
            "type": "object",
            "properties": {
              "recordsRead": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "recordsWritten": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bytesRead": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bytesWritten": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "durationMilliseconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "rowIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "stepId",
          "componentId",
          "state",
          "warningCount",
          "metrics"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contractVersion",
    "id",
    "pipelineId",
    "state",
    "createdAt",
    "warningCount",
    "steps"
  ],
  "additionalProperties": false,
  "$id": "https://pantaetl.dev/schemas/run.schema.json"
}
